rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role == 'superadmin';
    }

    function isOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isCollaborator() {
      return signedIn()
        && request.auth.token.email != null
        && lower(request.auth.token.email) in resource.data.collaboratorEmails;
    }

    function canManageChampionship() {
      return isPlatformAdmin() || isOwner() || isCollaborator();
    }

    function planStatusActive(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.billing.status == 'active';
    }

    function planTeamLimit(uid) {
      return !planStatusActive(uid) ? 16
        : get(/databases/$(database)/documents/users/$(uid)).data.billing.planId == 'enterprise' ? 999
        : get(/databases/$(database)/documents/users/$(uid)).data.billing.planId == 'pro' ? 64 : 16;
    }

    function planAthleteLimit(uid) {
      return !planStatusActive(uid) ? 200
        : get(/databases/$(database)/documents/users/$(uid)).data.billing.planId == 'enterprise' ? 9999
        : get(/databases/$(database)/documents/users/$(uid)).data.billing.planId == 'pro' ? 1000 : 200;
    }

    function withinPlanLimits() {
      return request.resource.data.teamCount is number
        && request.resource.data.athleteCount is number
        && request.resource.data.teamCount >= 0
        && request.resource.data.athleteCount >= 0
        && request.resource.data.teamCount <= planTeamLimit(request.resource.data.ownerUid)
        && request.resource.data.athleteCount <= planAthleteLimit(request.resource.data.ownerUid);
    }

    match /championships/{championshipId} {
      allow read: if canManageChampionship();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && withinPlanLimits();
      allow update: if canManageChampionship() && (isPlatformAdmin() || withinPlanLimits());
      allow delete: if canManageChampionship();

      match /registrations/{registrationId} {
        allow read, update, delete: if canManageChampionship();
        allow create: if exists(/databases/$(database)/documents/publicChampionships/$(championshipId))
            && get(/databases/$(database)/documents/publicChampionships/$(championshipId)).data.status != 'arquivado'
            && request.resource.data.status == 'pending'
            && request.resource.data.teamNameKey is string
            && request.resource.data.teamNameKey.size() > 0
            && request.resource.data.teamName is string
            && request.resource.data.responsible is string
            && request.resource.data.phone is string
            && request.resource.data.email is string
            && request.resource.data.consent == true
            && request.resource.data.captchaToken is string
            && request.resource.data.athletes is list
            && request.resource.data.athletes.size() > 0
            && request.resource.data.rosterMode is string
            && ((request.resource.data.rosterMode == 'individual' && request.resource.data.athletes.size() == 1)
              || (request.resource.data.rosterMode == 'dupla' && request.resource.data.athletes.size() == 2)
              || (request.resource.data.rosterMode == 'team' && request.resource.data.athletes.size() <= 50))
            && request.resource.data.created is number;
      }

      match /auditLogs/{auditId} {
        allow read: if canManageChampionship();
        allow create: if canManageChampionship();
      }
    }

    match /publicChampionships/{championshipId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Moved here from the old (unwritten, dead) rule under /championships — the client
      // (public-championship.js) has always written to publicChampionships/{id}/pollVotes,
      // never to the private collection, so voting was previously falling through to the
      // catch-all deny-all rule at the bottom of this file.
      match /pollVotes/{voteId} {
        allow read: if true;
        allow create: if voteId == request.resource.data.pollId + '_' + request.resource.data.voterKey
          && request.resource.data.pollId is string
          && request.resource.data.optionId is string
          && request.resource.data.voterKey is string
          && request.resource.data.voterKey.size() > 8
          && request.resource.data.voterKey.size() < 160
          && request.resource.data.created is number
          && request.resource.data.created <= request.time.toMillis();
        allow update, delete: if false;
      }

      // Anonymous, low-stakes engagement counters (portal views, sponsor clicks) for the
      // organizer's own engagement/sponsor-audience panel — no per-visitor dedup like
      // pollVotes, since repeat views/clicks from the same visitor are meaningful signal here,
      // not something to prevent.
      match /events/{eventId} {
        allow read: if true;
        allow create: if request.resource.data.type in ['view', 'sponsor_click']
          && (request.resource.data.type != 'sponsor_click' || (request.resource.data.sponsorId is string && request.resource.data.sponsorId.size() > 0))
          && request.resource.data.created is number
          && request.resource.data.created <= request.time.toMillis();
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isPlatformAdmin());
      allow create: if signedIn() && (request.auth.uid == userId || isPlatformAdmin());
      allow update: if isPlatformAdmin()
        || (signedIn() && request.auth.uid == userId && request.resource.data.billing == resource.data.billing);
      allow delete: if isPlatformAdmin();
    }

    match /platformAdmins/{userId} {
      allow read: if isPlatformAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isPlatformAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
